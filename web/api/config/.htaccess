# =========================================================================
# OneDev Track - Prevent Direct Web Access to Config Folder
# =========================================================================

# حظر جميع الطلبات المباشرة من المتصفح لملفات هذا المجلد
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
